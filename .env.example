# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL, used for links in emails and auth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store details. Unset values show as [PLACEHOLDER] text from the design.
STORE_ADDRESS=
STORE_OPENING_HOURS=
STORE_PHONE=
STORE_EMAIL=
DELIVERY_DAYS=
FREE_DELIVERY_THRESHOLD=
RETURN_WINDOW_DAYS=
