# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL, used for links in emails and auth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store details. Address, hours, phone and email are hidden until set.
# Delivery days defaults to 3–5 and the return window to 14.
STORE_ADDRESS=
STORE_OPENING_HOURS=
STORE_PHONE=
STORE_EMAIL=
DELIVERY_DAYS=
RETURN_WINDOW_DAYS=

# Pricing in naira
DELIVERY_FEE=3500
FREE_DELIVERY_THRESHOLD=50000

# Postgres connection string (Neon pooled URL in production)
DATABASE_URL=

# Paystack (use the sk_test_ key for test mode)
PAYSTACK_SECRET_KEY=

# Mailgun, for order confirmation emails
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_API_URL=https://api.mailgun.net

# Auth.js with Google (see README for Google Cloud Console setup)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to true when not running on Vercel
AUTH_TRUST_HOST=
