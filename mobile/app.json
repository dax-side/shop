{
  "expo": {
    "name": "Oja Supply Co.",
    "slug": "oja-supply",
    "version": "1.0.0",
    "scheme": "ojasupply",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.ojasupply.app"
    },
    "android": {
      "package": "co.ojasupply.app",
      "adaptiveIcon": {
        "backgroundColor": "#171614",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f1efea",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#f1efea"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "612cb203-082c-47d6-a48d-5e71fe5efbc4"
      }
    },
    "owner": "dax-side",
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/612cb203-082c-47d6-a48d-5e71fe5efbc4"
    }
  }
}
